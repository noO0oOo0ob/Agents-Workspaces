{
  "name": "agents-workspaces",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-agent workspace orchestrator for Codex and Claude Code",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n daemon,web -c cyan,magenta \"npm run dev:daemon\" \"npm run dev:web\"",
    "dev:daemon": "npm run dev --workspace @agents-workspaces/daemon",
    "dev:web": "npm run dev --workspace @agents-workspaces/web",
    "start": "tsx apps/cli/src/index.ts start",
    "build": "npm run typecheck && npm run build --workspace @agents-workspaces/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/*/src/*.test.ts apps/*/src/*.test.ts",
    "test:watch": "node --import tsx --test --watch packages/*/src/*.test.ts apps/*/src/*.test.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "doctor": "npm run dev --workspace @agents-workspaces/cli -- doctor",
    "docker:build": "docker build -f docker/base/Dockerfile -t agents-workspaces-runner:local ."
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
